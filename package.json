{
  "name": "pew-game",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "bun run build && bun scripts/local-worker.ts dev",
    "build": "bun run types && next build",
    "start": "bun scripts/local-worker.ts dev",
    "deploy": "bun run build && wrangler d1 migrations apply pew-game --env '' --remote && wrangler deploy --env ''",
    "deploy:check": "wrangler deploy --env '' --dry-run",
    "types": "mkdir -p .wrangler && wrangler types .wrangler/types.d.ts --env ''",
    "lint": "eslint --max-warnings=0 src/ worker/ scripts/ e2e/",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run src/__tests__/e2e src/__tests__/integration",
    "test:e2e:bdd": "bun run build && playwright test",
    "check": "bun run lint && bun run test",
    "typecheck": "bun run types && tsc --noEmit && tsc --project tsconfig.worker.json"
  },
  "dependencies": {
    "next": "16.3.4",
    "postcss": "^8.5.28",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "26.4.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "^10.10.0",
    "eslint-config-next": "16.3.4",
    "husky": "^9.1.7",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.0",
    "wrangler": "4.131.1"
  },
  "overrides": {
    "baseline-browser-mapping": "^2.11.0",
    "brace-expansion": "^5.0.9",
    "minimatch@3>brace-expansion": "^5.0.9",
    "minimatch@10>brace-expansion": "^5.0.9",
    "@babel/core": "^7.29.7",
    "browserslist": "4.28.7",
    "js-yaml": "^4.2.0",
    "vite": "^8.0.16",
    "sharp": "^0.35.4",
    "postcss": "^8.5.28",
    "nanoid": "^3.3.18"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0"
    ]
  },
  "patchedDependencies": {
    "minimatch@3.1.5": "patches/minimatch@3.1.5.patch"
  }
}
