{
  "name": "pew.md",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0 src/",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run src/__tests__/e2e",
    "test:e2e:bdd": "bunx playwright test",
    "check": "bun run lint && bun run test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "next": "16.3.0",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "trustedDependencies": [
    "better-sqlite3"
  ],
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-config-next": "16.3.0",
    "husky": "^9.1.7",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "minimatch@3>brace-expansion": "^5.0.9",
    "minimatch@10>brace-expansion": "^5.0.9",
    "@babel/core": "^7.29.7",
    "js-yaml": "^4.2.0",
    "vite": "^8.0.16",
    "sharp": "^0.35.3",
    "postcss": "^8.5.26"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0"
    ]
  },
  "patchedDependencies": {
    "minimatch@3.1.5": "patches/minimatch@3.1.5.patch"
  }
}
